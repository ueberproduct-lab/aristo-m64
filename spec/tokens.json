{
  "$comment": "Single source of truth for the Aristo M 64 look. Referenced by SPEC.md and eval/. Builder must expose every color as a CSS custom property on :root with exactly these values.",
  "colors": {
    "--m64-faceplate": "#1c1c1d",
    "--m64-shell": "#e8e6e0",
    "--m64-key-white": "#f4f3ee",
    "--m64-key-yellow": "#f2ae3a",
    "--m64-key-red": "#d4532e",
    "--m64-legend": "#151515",
    "--m64-logo": "#e6e6e2",
    "--m64-display-window": "#200806",
    "--m64-led-on": "#ff3a24",
    "--m64-led-ghost": "#3b0d08",
    "--m64-switch-knob": "#edede9"
  },
  "pixelTolerance": {
    "faceplateDeltaE": 10,
    "shellDeltaE": 12,
    "keyDeltaE": 14
  },
  "geometry": {
    "shellAspect": {
      "target": 2.0,
      "tolerance": 0.05,
      "$comment": "height / width of [data-part=shell] incl. case — 1.8: measured on the frontal M 85 S photo (spec/reference/m85s-front-proportionen.png): case 577 × 1156 px"
    },
    "verticalFractions": {
      "$comment": "height of part / height of [data-part=faceplate] — 1.8: from the frontal M 85 S photo (head 0.174, switches 0.06, display section 0.135 incl. bezel, keypad 0.52, foot 0.11); display window as on the M 64 (slim LED strip)",
      "tolerance": 0.015,
      "head": 0.175,
      "switches": 0.065,
      "display": 0.075,
      "keypad": 0.53,
      "foot": 0.105
    },
    "keyAspect": {
      "min": 0.9,
      "max": 1.15,
      "$comment": "width / height of each key"
    },
    "keyWidthOfFaceplate": {
      "target": 0.142,
      "tolerance": 0.01,
      "$comment": "M 64 front photo: key 150 / device 1015 px"
    },
    "columnPitchOverKeyWidth": {
      "min": 1.65,
      "max": 1.8
    },
    "rowPitchOverKeyWidth": {
      "min": 1.5,
      "max": 1.68,
      "$comment": "≈1.6 makes 5 rows fit the keypad fraction"
    },
    "keyRadiusOfWidth": {
      "min": 0.12,
      "max": 0.18,
      "$comment": "M 64 front photo ≈ 0.15"
    },
    "digitCellAspect": {
      "min": 1.3,
      "max": 2.2,
      "$comment": "height / width of a [data-part=digit]"
    },
    "desktopViewport": {
      "width": 1280,
      "height": 900
    },
    "desktopShellHeightOfViewport": {
      "min": 0.7,
      "max": 0.95
    },
    "mobileViewport": {
      "width": 375,
      "height": 812
    },
    "mobileMinKeySize": 44
  },
  "led": {
    "litMinRed": 180,
    "litMaxGreen": 110,
    "litMaxBlue": 110,
    "ghostMinDeltaEFromWindow": 3,
    "ghostMaxLightness": 35,
    "glowMinRedGain": 8
  },
  "segments": {
    "0": "abcdef",
    "1": "bc",
    "2": "abdeg",
    "3": "abcdg",
    "4": "bcfg",
    "5": "acdfg",
    "6": "acdefg",
    "7": "abc",
    "8": "abcdefg",
    "9": "abcdfg",
    "E": "adefg",
    "-": "g"
  },
  "keys": [
    {
      "key": "C",
      "legend": "C",
      "color": "red",
      "label": "Löschen"
    },
    {
      "key": "%",
      "legend": "%",
      "color": "yellow",
      "label": "Prozent"
    },
    {
      "key": "sqrt",
      "legend": "√",
      "color": "yellow",
      "label": "Wurzel"
    },
    {
      "key": "CE",
      "legend": "CE",
      "color": "red",
      "label": "Eingabe löschen"
    },
    {
      "key": "7",
      "legend": "7",
      "color": "white",
      "label": "7"
    },
    {
      "key": "8",
      "legend": "8",
      "color": "white",
      "label": "8"
    },
    {
      "key": "9",
      "legend": "9",
      "color": "white",
      "label": "9"
    },
    {
      "key": "/",
      "legend": "÷",
      "color": "yellow",
      "label": "geteilt durch"
    },
    {
      "key": "4",
      "legend": "4",
      "color": "white",
      "label": "4"
    },
    {
      "key": "5",
      "legend": "5",
      "color": "white",
      "label": "5"
    },
    {
      "key": "6",
      "legend": "6",
      "color": "white",
      "label": "6"
    },
    {
      "key": "*",
      "legend": "×",
      "color": "yellow",
      "label": "mal"
    },
    {
      "key": "1",
      "legend": "1",
      "color": "white",
      "label": "1"
    },
    {
      "key": "2",
      "legend": "2",
      "color": "white",
      "label": "2"
    },
    {
      "key": "3",
      "legend": "3",
      "color": "white",
      "label": "3"
    },
    {
      "key": "-",
      "legend": "−",
      "color": "yellow",
      "label": "minus"
    },
    {
      "key": "0",
      "legend": "0",
      "color": "white",
      "label": "0"
    },
    {
      "key": ".",
      "legend": "·",
      "color": "white",
      "label": "Komma"
    },
    {
      "key": "=",
      "legend": "=",
      "color": "yellow",
      "label": "ist gleich"
    },
    {
      "key": "+",
      "legend": "+",
      "color": "yellow",
      "label": "plus"
    }
  ],
  "switches": [
    {
      "id": "k",
      "left": "0",
      "right": "K",
      "functional": false
    },
    {
      "id": "dec",
      "left": "F",
      "right": "2",
      "functional": false
    },
    {
      "id": "power",
      "left": "0",
      "right": "I",
      "functional": true
    }
  ],
  "case": {
    "$comment": "F8 Schutzhülle. The device itself is black; the cream part is a removable tray-like case.",
    "default": "on",
    "storageKey": "m64-case",
    "rimSampleFractionsOfHeight": [
      0.03,
      0.5,
      0.9
    ],
    "layoutShiftMaxPx": 0.5,
    "offBackgroundMaxDeltaE": 8,
    "offBodyMaxLightness": 30,
    "backgroundSampleOffsetPx": 20,
    "rimOfShellWidth": {
      "target": 0.023,
      "tolerance": 0.007,
      "$comment": "all four sides, M 85 S photo: 13–15 px of 577"
    }
  },
  "golden": {
    "maxDiffPixelRatio": 0.001,
    "$comment": "device-element screenshot; 0.1 % catches details like the case corners"
  },
  "flicker": {
    "minMs": 40,
    "maxMs": 120,
    "minOpacity": 0.6,
    "maxDipOpacity": 0.95
  },
  "sound": {
    "$comment": "F10: values validated against a reference 'satt-mechanisch' click (body + plastic resonance + transient) that passes, and a dull bass-only thud that fails; 1.6: quieter — peak 0.08–0.2 (≈ −22…−14 dBFS): full-bodied but not loud at medium system volume; 1.6b: a touch less bassy — energy below 600 Hz 35–60 %, centroid 1000–2000 Hz (was 74 % / 846 Hz); 1.9: no sharp tick (\"Spitze raus\", Markus) — soft attack ≥2.5 ms, ≤1.5 % above 3 kHz, 3–12 % above 2 kHz; level as heard in the sound check (A ≈ 0.14) is right. Validated with a reference: attack 3.3 ms, centroid 1125 Hz, 44 % < 600 Hz, 0 % > 3 kHz.",
    "peakMin": 0.08,
    "peakMax": 0.2,
    "attackMaxMs": 6,
    "minMs": 15,
    "maxMs": 120,
    "lowCutHz": 600,
    "lowShareMin": 0.35,
    "lowShareMax": 0.6,
    "highCutHz": 2000,
    "highShareMin": 0.03,
    "centroidMin": 900,
    "centroidMax": 2000,
    "minVariation": 0.001,
    "attackMinMs": 2.5,
    "highShareMax": 0.12,
    "veryHighCutHz": 3000,
    "veryHighShareMax": 0.015,
    "rowPitch": {
      "$comment": "F15 (2.1): bottom row lowest, each row above slightly higher",
      "semitonesPerRow": 0.75,
      "toleranceSemitones": 0.6,
      "minStepSemitones": 0.3
    }
  },
  "mute": {
    "default": "on",
    "storageKey": "m64-sound"
  },
  "polish": {
    "$comment": "F12 Feinschliff (Spec 1.7). Thresholds calibrated against the 1.6 render: head step 6.7, foot ledge 0, flat 0, logo tracking 0.20em, knob fill 0.78.",
    "logoTrackingMin": 0.1,
    "logoTrackingMax": 0.14,
    "logoWordSpacingMax": 0.1,
    "logoFamilies": [
      "Futura",
      "Avenir Next",
      "Avenir",
      "Century Gothic"
    ],
    "logoWeightMin": 400,
    "logoWeightMax": 600,
    "knobFillMin": 0.85,
    "knobAspectMin": 1.1,
    "knobAspectMax": 2.1,
    "knobEdgeMinDeltaL": 8,
    "reliefSampleX": [
      0.03,
      0.97
    ],
    "reliefBandPx": 6,
    "headStepMinDeltaL": 10,
    "footLedgeMinDeltaL": 6,
    "flatMaxDeltaL": 3
  },
  "detail": {
    "$comment": "F13 (1.8): close to the M 64 front detail photo (spec/reference/m64-front-detail.jpg). Calibrated on the 1.7 render: stroke 0.183, glyph 0.66, ghost ΔE 16.9, depth 2.7, window 0.86, slot L* 1.6, corner 0.017, bevel 0, key radius 0.10, CE/C 0.74.",
    "cornerRadiusMin": 0.025,
    "cornerRadiusMax": 0.05,
    "windowWidthOfFaceplate": {
      "target": 0.9,
      "tolerance": 0.03
    },
    "strokeOfCellMax": 0.13,
    "glyphOfWindowMax": 0.55,
    "ghostMaxDeltaE": 8,
    "windowDepthMinDeltaL": 4,
    "slotMinLightness": 60,
    "slotMinLightnessVeiled": 45,
    "veilMaxDeltaE": 15,
    "ceSizeOfCMin": 0.95,
    "audibleMinPeak": 0.02,
    "sideRounding": {
      "$comment": "1.9: clearly visible rounded side edges — light band along both sides (1.8 render: 1 px at ΔL* 3)",
      "bandOfWidth": 0.05,
      "interiorAtOfWidth": 0.1,
      "peakMinDeltaL": 8,
      "zoneMinDeltaL": 3,
      "zoneMinPx": 4
    },
    "audioGestureEvents": [
      "click",
      "pointerup",
      "mouseup",
      "keydown",
      "keyup",
      "touchend"
    ]
  },
  "switchesF14": {
    "$comment": "F14 (Spec 2.0): slide switches like m64-front-detail.jpg. Calibrated on the 1.9 render: guide 0.126, knob 0.94× slot, hard edge 3 L*, top−front ≈13, labels 0.42 × logo at L* 86.",
    "slotOfWidth": {
      "target": 0.15,
      "tolerance": 0.012
    },
    "knobOverSlotHeight": {
      "min": 1.2,
      "max": 1.5
    },
    "knobOfSlotWidth": {
      "min": 0.35,
      "max": 0.5
    },
    "topMinusFrontMinDeltaL": 15,
    "hardEdgeMinStepL": 8,
    "labelOfLogoMin": 0.5,
    "labelMinLightness": 89
  }
}
